---
import '../styles/base.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import OgCard from '../assets/figure/og-card.png';
import ContributionGraph from '../components/ContributionGraph.astro';
import Icon from '../components/Icon.astro';
import { getSiteConfig } from '../utils/site';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
}

const { title, description, image = OgCard } = Astro.props;
const { site, profile } = await getSiteConfig();

const imageUrl = typeof image === 'string' ? image : image.src;
const canonical = new URL(Astro.url.pathname, Astro.site);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

const withBase = (href: string) =>
  href === '/' ? `${basePath}/` : `${basePath}${href.startsWith('/') ? href : `/${href}`}`;

const asset = (path: string) => `${import.meta.env.BASE_URL}${path}`;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { href: '/', icon: 'home', label: 'Home' },
  { href: '/projects', icon: 'gallery', label: 'Projects' },
  { href: '/about', icon: 'user', label: 'Profile' },
  { href: '/blog', icon: 'pen', label: 'Writing' },
];

const isActive = (href: string) => {
  const target = withBase(href).replace(/\/$/, '') || '/';
  return target === '/' ? currentPath === '/' : currentPath.startsWith(target);
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <ClientRouter />
    <Font cssVariable="--font-sans" preload />

    <script is:inline>
      (() => {
        const key = 'site-theme';
        const root = document.documentElement;
        const stored = (() => {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        })();
        const system = () =>
          window.matchMedia?.('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

        const apply = (theme, persist) => {
          const next = theme === 'dark' ? 'dark' : 'light';
          root.dataset.theme = next;
          if (persist) {
            try {
              localStorage.setItem(key, next);
            } catch {}
          }
          for (const b of document.querySelectorAll('[data-theme-toggle]')) {
            b.setAttribute(
              'aria-label',
              next === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
            );
            b.setAttribute('data-tooltip', next === 'dark' ? 'Light mode' : 'Dark mode');
          }
          window.dispatchEvent(new CustomEvent('site:theme-change', { detail: { theme: next } }));
        };

        apply(stored || system(), false);

        if (!window.__siteThemeReady) {
          window.__siteThemeReady = true;
          document.addEventListener('click', (e) => {
            if (e.target.closest?.('[data-theme-toggle]')) {
              apply(root.dataset.theme === 'dark' ? 'light' : 'dark', true);
            }
          });
          document.addEventListener('astro:page-load', () =>
            apply(root.dataset.theme || stored || system(), false),
          );
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href={asset('favicon.svg')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={asset('favicon-32x32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={asset('apple-touch-icon.png')} />
    <link rel="manifest" href={asset('manifest.json')} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={withBase('/rss.xml')}
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(imageUrl, Astro.url)} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(imageUrl, Astro.url)} />
  </head>

  <body>
    <header class="site-header">
      <nav class="container nav" aria-label="Main">
        <div class="cluster">
          {
            navItems.map((item) => (
              <a
                class="chip"
                href={withBase(item.href)}
                aria-label={item.label}
                data-tooltip={item.label}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                <Icon name={item.icon} size={20} />
              </a>
            ))
          }
        </div>

        <div class="cluster">
          <button
            class="chip"
            type="button"
            data-theme-toggle
            aria-label="Switch theme"
            data-tooltip="Theme"
          >
            <span class="only-light sun"><Icon name="sun" size={20} /></span>
            <span class="only-dark"><Icon name="moon" size={20} /></span>
          </button>

          <a
            class="chip social"
            href={profile.linkedin}
            target="_blank"
            rel="noreferrer"
            aria-label="LinkedIn"
            data-tooltip="LinkedIn"
          >
            <Icon name="linkedin" size={18} />
          </a>

          <a
            class="chip pill"
            href={profile.github}
            target="_blank"
            rel="noreferrer"
            aria-label="GitHub"
          >
            <Icon name="github" size={24} />
            <span class="pill-label text-sm">{profile.handle}</span>
          </a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="section-padding container stack site-footer">
      <ContributionGraph />
      <div class="footer-contact">
        <a class="link-underline text-lg" href={`mailto:${profile.email}`}>{profile.email}</a>
      </div>
    </footer>

    <div class="fade" aria-hidden="true"></div>

    <style>
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      main {
        flex: 1;
      }

      /* ---------- header ---------- */

      .site-header {
        z-index: 50;
        width: 100%;
        backdrop-filter: blur(8px);
      }

      .nav {
        display: flex;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
        margin-top: 1.25rem;
      }

      @media (min-width: 768px) {
        .nav {
          margin-top: 2rem;
        }
      }

      .cluster {
        display: flex;
        gap: 0.75rem;
        align-items: center;
      }

      .chip {
        display: inline-flex;
        flex: none;
        gap: 0.5rem;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        padding: 0;
        border: none;
        border-radius: var(--radius-full);
        background: var(--muted);
        color: var(--foreground);
        font-size: var(--text-sm);
        cursor: pointer;
        transition: background 150ms var(--ease);
      }

      @media (hover: hover) {
        .chip:hover {
          background: color-mix(in oklab, var(--muted) 75%, transparent);
        }
      }

      /* ---------- chip tooltip ---------- */

      .chip[data-tooltip] {
        position: relative;
      }

      .chip[data-tooltip]::before,
      .chip[data-tooltip]::after {
        position: absolute;
        left: 50%;
        z-index: 10;
        opacity: 0;
        transform: translate(-50%, -0.25rem);
        pointer-events: none;
        transition:
          opacity 150ms var(--ease),
          transform 150ms var(--ease);
      }

      /* notch — its 0.75rem box overlaps the bubble edge so the two read as one shape */
      .chip[data-tooltip]::before {
        content: '';
        top: calc(100% - 0.2rem);
        border: 0.375rem solid transparent;
        border-bottom-color: var(--foreground);
      }

      .chip[data-tooltip]::after {
        content: attr(data-tooltip);
        top: calc(100% + 0.5rem);
        padding: 0.5rem 1rem;
        border-radius: var(--radius-md);
        background: var(--foreground);
        color: var(--background);
        font-size: var(--text-sm);
        line-height: 1;
        white-space: nowrap;
      }

      @media (hover: hover) {
        .chip[data-tooltip]:hover::before,
        .chip[data-tooltip]:hover::after {
          opacity: 1;
          transform: translate(-50%, 0);
        }
      }

      .chip[data-tooltip]:focus-visible::before,
      .chip[data-tooltip]:focus-visible::after {
        opacity: 1;
        transform: translate(-50%, 0);
      }

      .pill {
        gap: 0.625rem;
        width: auto;
        padding-inline: 0.5rem 1rem;
      }

      .pill-label {
        line-height: 1;
      }

      .social {
        display: none;
      }

      @media (min-width: 480px) {
        .social {
          display: inline-flex;
        }
      }

      .sun {
        color: var(--sun);
      }

      .only-dark {
        display: none;
      }

      :global([data-theme='dark']) .only-dark {
        display: inline-flex;
      }

      :global([data-theme='dark']) .only-light {
        display: none;
      }

      /* ---------- footer ---------- */

      .site-footer {
        --stack: 9.375rem;

        padding-bottom: 4rem;
      }

      .footer-contact {
        display: flex;
        justify-content: center;
      }

      /* ---------- bottom fade ---------- */

      .fade {
        position: fixed;
        right: 0;
        bottom: 0;
        left: 0;
        z-index: 30;
        height: 2.5rem;
        background: linear-gradient(
          to top,
          color-mix(in oklab, var(--background) 50%, transparent),
          transparent
        );
        backdrop-filter: blur(2px);
        pointer-events: none;
      }

      @media (min-width: 768px) {
        .fade {
          height: 4rem;
        }
      }

      @media (max-width: 420px) {
        .pill-label {
          display: none;
        }

        .pill {
          width: 2.5rem;
          padding-inline: 0;
        }
      }
    </style>
  </body>
</html>
