---
import { getCollection } from 'astro:content';
import Icon from '../components/Icon.astro';
import Img from '../components/Img.astro';
import PostRow from '../components/PostRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Site from '../layouts/Site.astro';
import { getSiteConfig } from '../utils/site';
import { sortByDateDesc } from '../utils/content';
import { getProjects, withBase } from '../utils/projects';

const { site, profile, home } = await getSiteConfig();

// profile.avatar is a configured string; a glob is what turns it into a real
// import so astro:assets can hash and resize it. Falls back to the raw string
// (a public/ or remote path) when it names nothing under src/assets.
const siteImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/site-images/**/*.{webp,avif,png,jpg,jpeg}',
  { eager: true },
);
const avatar = siteImages[profile.avatar]?.default ?? profile.avatar;

const projects = (await getProjects()).slice(0, 4);
const posts = sortByDateDesc(await getCollection('blog', ({ data }) => !data.draft)).slice(0, 3);

// The reel loops by translating a doubled track -50%, so the base set has to be
// wide enough to fill the viewport on its own. With only a couple of projects
// that means repeating them.
const reelBase = projects.length
  ? Array.from({ length: Math.ceil(4 / projects.length) }, () => projects).flat()
  : [];
---

<Site title={site.pageTitle} description={site.pageDescription}>
  {/* ---------- hero ---------- */}
  <section class="hero-padding container stack">
    <div class="avatar reveal">
      <Img src={avatar} alt={`${profile.name} avatar`} widths={[64, 128, 192]} sizes="64px" />
    </div>

    <div class="intro reveal" style="--reveal-delay:80ms">
      <h1 class="text-3xl md:text-4xl">{home.intro.title}</h1>
      <p class="muted text-lg leading-snug">{profile.meta}</p>
    </div>

    <div class="reveal" style="--reveal-delay:160ms">
      <a class="cta" href={withBase('/contact')}>
        <Icon name="mail" size={18} />
        Contact
      </a>
    </div>
  </section>

  {/* ---------- works ---------- */}
  {
    projects.length > 0 && (
      <section class="section-padding bigger-container stack pt-0">
        <div class="inner-container block-head">
          <h2 class="text-2xl leading-none">Works</h2>
          <a class="link-underline text-lg leading-none" href={withBase('/projects')}>
            View all
          </a>
        </div>

        <div class="reel" data-reel>
          <ul class="reel-track" style={`--reel-duration:${reelBase.length * 7}s`}>
            {reelBase.map((p) => (
              <li class="reel-item">
                <ProjectCard
                  href={withBase(`/projects/${p.id}/`)}
                  title={p.data.title}
                  description={p.data.description}
                  heroImage={p.data.heroImage}
                  categories={p.data.categories}
                />
              </li>
            ))}
            {reelBase.map((p) => (
              <li class="reel-item" data-clone aria-hidden="true">
                <ProjectCard
                  href={withBase(`/projects/${p.id}/`)}
                  title={p.data.title}
                  description={p.data.description}
                  heroImage={p.data.heroImage}
                  categories={p.data.categories}
                />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {/* ---------- my stack ---------- */}
  {
    home.stack.length > 0 && (
      <section class="section-padding bigger-container stack">
        <h2 class="inner-container text-2xl leading-none">Stack</h2>

        <ul class="tiles">
          {home.stack.map((item) => (
            <li class="tile" style={item.color && `--brand: ${item.color}`}>
              <Icon name={item.icon} size={36} />
              <span class="tile-label">{item.name}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ---------- about ---------- */}
  {
    home.about.length > 0 && (
      <section class="section-padding bigger-container stack about-section">
        <div class="inner-container stack">
          <h2 class="text-2xl leading-none">About</h2>
          <div class="muted text-lg about-copy">
            {home.about.map((para) => (
              <p>{para}</p>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* ---------- experience ---------- */}
  {
    home.experience.length > 0 && (
      <section class="section-padding container stack">
        <h2 class="text-2xl leading-none">Experience</h2>

        <div class="two-col">
          <ul class="roles">
            {home.experience.map((job) => (
              <li class="text-lg leading-none">
                {job.href ? (
                  <a class="link-underline" href={job.href} target="_blank" rel="noreferrer">
                    {job.company}
                  </a>
                ) : (
                  <span>{job.company}</span>
                )}
                <p class="muted">{job.role}</p>
                <p class="muted">{job.period}</p>
              </li>
            ))}
          </ul>

          {home.skills.length > 0 && (
            <div>
              <p class="text-lg leading-none skills-head">Skills</p>
              <ul class="skills">
                {home.skills.map((skill) => (
                  <li class="muted text-lg">{skill}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )
  }

  {/* ---------- currently ---------- */}
  {
    home.doing.length > 0 && (
      <section class="section-padding container stack">
        <h2 class="text-2xl leading-none">Currently</h2>
        <ul class="doing">
          {home.doing.map((item) => (
            <li class="text-lg">
              <span class="muted text-base doing-mark">{item.mark}</span>
              <span>{item.text}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ---------- blog ---------- */}
  {
    posts.length > 0 && (
      <section class="section-padding bigger-container stack">
        <div class="inner-container block-head">
          <h2 class="text-2xl leading-none">Blog</h2>
          <a class="link-underline text-lg" href={withBase('/blog')}>
            Read all
          </a>
        </div>

        <ul class="rows surface">
          {posts.map((post, i) => (
            <PostRow
              href={withBase(`/blog/${post.id}/`)}
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              delay={i * 80}
            />
          ))}
        </ul>
      </section>
    )
  }
</Site>

<script>
  // Feeds the CTA's specular gradient the pointer position.
  const cta = document.querySelector('.cta');

  if (cta && window.matchMedia('(hover: hover)').matches) {
    cta.addEventListener('pointermove', (event) => {
      const rect = cta.getBoundingClientRect();
      cta.style.setProperty('--mx', `${event.clientX - rect.left}px`);
      cta.style.setProperty('--my', `${event.clientY - rect.top}px`);
    });
  }

  // The reel's second half is a visual clone: hidden from screen readers, and
  // pulled out of the tab order here so it doesn't double every link.
  for (const link of document.querySelectorAll('[data-clone] a')) {
    link.setAttribute('tabindex', '-1');
  }
</script>

<style>
  .avatar {
    position: relative;
    overflow: hidden;
    width: 4rem;
    height: 4rem;
    border-radius: var(--radius-full);
    background: var(--muted);
  }

  .avatar img {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  /* Frosted-glass CTA. Tokens live in base.css so the nav, tiles and tabs
     share one definition of "glass". */
  .cta {
    position: relative;
    z-index: 0;
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    overflow: hidden;
    height: 2.875rem;
    padding-inline: 1.5rem;
    border: 1px solid var(--glass-edge);
    border-radius: var(--radius-full);
    background: var(--glass-tint);
    box-shadow:
      0 1px 2px color-mix(in oklab, var(--foreground) 6%, transparent),
      0 10px 26px -14px color-mix(in oklab, var(--foreground) 40%, transparent),
      inset 0 1px 0 var(--glass-sheen);
    color: var(--foreground);
    font-size: var(--text-base);
    line-height: 1;
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    transition:
      background 200ms var(--ease),
      border-color 200ms var(--ease),
      box-shadow 300ms var(--ease),
      transform 200ms var(--ease);
  }

  /* the fluid part — a specular pool that tracks the pointer */
  .cta::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background: radial-gradient(
      5rem circle at var(--mx, 50%) var(--my, 50%),
      var(--glass-glow),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 250ms var(--ease);
  }

  /* fixed top-down sheen, so it still reads as glass with no pointer at all */
  .cta::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(to bottom, var(--glass-top), transparent 55%);
    pointer-events: none;
  }

  @media (hover: hover) {
    .cta:hover {
      border-color: var(--glass-edge-strong);
      background: var(--glass-strong);
      box-shadow:
        0 1px 2px color-mix(in oklab, var(--foreground) 8%, transparent),
        0 16px 34px -14px color-mix(in oklab, var(--foreground) 45%, transparent),
        inset 0 1px 0 var(--glass-sheen);
      transform: translateY(-1px);
    }

    .cta:hover::before {
      opacity: 1;
    }
  }

  .cta:active {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta,
    .cta:hover {
      transform: none;
    }
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .block-head {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }

  /* works — a continuously scrolling reel. The track holds the set twice over
     and slides exactly half its width, so the seam is invisible and the loop
     never resets visibly. Hover or keyboard focus pauses it. */
  .reel {
    --reel-gap: 1.5rem;

    position: relative;
    overflow: hidden;
    /* cards fade in and out at the edges instead of being cut off */
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 5rem,
      #000 calc(100% - 5rem),
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 5rem,
      #000 calc(100% - 5rem),
      transparent
    );
  }

  .reel-track {
    display: flex;
    gap: var(--reel-gap);
    width: max-content;
    margin: 0;
    padding: 1rem 0 1.5rem;
    list-style: none;
    animation: reel var(--reel-duration, 40s) linear infinite;
  }

  .reel:hover .reel-track,
  .reel:focus-within .reel-track {
    animation-play-state: paused;
  }

  .reel-item {
    flex: 0 0 clamp(16rem, 74vw, 22rem);
    transition: transform 300ms var(--ease);
  }

  @media (hover: hover) {
    .reel-item:hover {
      transform: translateY(-4px);
    }
  }

  @keyframes reel {
    to {
      transform: translateX(calc(-50% - var(--reel-gap) / 2));
    }
  }

  /* No motion: drop the animation and hand the track back to the scrollbar. */
  @media (prefers-reduced-motion: reduce) {
    .reel {
      overflow-x: auto;
      mask-image: none;
      -webkit-mask-image: none;
    }

    .reel-track {
      animation: none;
    }
  }

  /* my stack */
  .tiles {
    display: flex;
    flex-wrap: wrap;
    gap: 1.0625rem;
    margin-top: 3.75rem;
    align-items: center;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 1024px) {
    .tiles {
      justify-content: space-between;
    }
  }

  .tile {
    position: relative;
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 6.25rem;
    height: 6.25rem;
    border: 1px solid var(--glass-edge);
    border-radius: var(--radius-lg);
    background: var(--glass-tint);
    box-shadow: inset 0 1px 0 var(--glass-sheen);
    color: var(--muted-foreground);
    transform-origin: center bottom;
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    transition:
      color 300ms var(--ease),
      background 300ms var(--ease),
      border-color 300ms var(--ease),
      transform 260ms var(--ease);
  }

  /* Dock label. Kept in the DOM at opacity 0 so it still reads out to
     screen readers — it replaces the old .sr-only span. */
  .tile-label {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    z-index: 3;
    transform: translate(-50%, 0.25rem);
    padding: 0.3125rem 0.6875rem;
    border: 1px solid var(--glass-edge);
    border-radius: var(--radius-full);
    background: color-mix(in oklab, var(--card) 88%, transparent);
    box-shadow:
      var(--shadow-xs),
      inset 0 1px 0 var(--glass-sheen);
    color: var(--foreground);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 200ms var(--ease),
      transform 200ms var(--ease);
  }

  @media (hover: hover) {
    .tile:hover {
      z-index: 2;
      border-color: var(--glass-edge-strong);
      background: var(--glass-strong);
      color: var(--brand, var(--foreground));
      transform: scale(1.14);
    }

    /* Dock falloff — the tiles either side of the hovered one lift a little. */
    .tiles .tile:hover + .tile,
    .tiles .tile:has(+ .tile:hover) {
      transform: scale(1.06);
    }

    .tile:hover .tile-label {
      transform: translate(-50%, 0);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile:hover,
    .tiles .tile:hover + .tile,
    .tiles .tile:has(+ .tile:hover) {
      transform: none;
    }
  }

  /* about */
  .about-copy > * + * {
    margin-top: 2rem;
  }

  @media (min-width: 768px) {
    .about-copy > * + * {
      margin-top: 2.75rem;
    }
  }

  /* experience */
  .two-col {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .two-col {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .roles,
  .skills {
    padding: 0;
    list-style: none;
  }

  .roles > li + li {
    margin-top: 2.5rem;
  }

  .roles p {
    margin-top: 1rem;
  }

  .skills-head {
    margin-bottom: 1rem;
  }

  .skills > li + li {
    margin-top: 1rem;
  }

  /* currently */
  .doing {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .doing li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }

  .doing-mark {
    flex: none;
  }

  /* blog */
  .rows {
    padding: 0;
    list-style: none;
  }
</style>
