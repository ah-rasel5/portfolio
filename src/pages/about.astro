---
import { getEntry, render } from 'astro:content';
import Icon from '../components/Icon.astro';
import Site from '../layouts/Site.astro';
import { getSiteConfig } from '../utils/site';

const { profile } = await getSiteConfig();

const about = await getEntry('about', 'about');
if (!about) throw new Error('Missing src/content/about.mdx content entry.');

const { Content } = await render(about);
---

<Site title={about.data.title} description={about.data.description}>
  <section class="hero-padding">
    <div class="container narrow head">
      <h1>{about.data.title}</h1>
      <p class="muted lede">{about.data.description}</p>

      <dl class="facts">
        <div>
          <dt class="muted">Role</dt>
          <dd>{profile.role}</dd>
        </div>
        <div>
          <dt class="muted">Company</dt>
          <dd>{profile.company}</dd>
        </div>
        <div>
          <dt class="muted">Location</dt>
          <dd>{profile.location}</dd>
        </div>
      </dl>

      <div class="links">
        <a class="pill" href={`mailto:${profile.email}`}>
          <Icon name="mail" size={15} />
          Email
        </a>
        <a class="pill" href={profile.github} target="_blank" rel="noreferrer">
          <Icon name="github" size={15} />
          GitHub
        </a>
      </div>
    </div>
  </section>

  <section class="container narrow">
    <div class="prose">
      <Content />
    </div>
  </section>
</Site>

<style>
  .narrow {
    max-width: 44rem;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  h1 {
    font-size: clamp(1.875rem, 5vw, 2.5rem);
  }

  .lede {
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .facts {
    display: grid;
    gap: 1rem;
    margin: 1rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  @media (min-width: 640px) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .facts div {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  dt {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    font-size: 0.95rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .pill {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    height: 2.25rem;
    padding-inline: 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--muted-foreground);
    font-size: 0.875rem;
    transition:
      background 150ms var(--ease),
      color 150ms var(--ease);
  }

  .pill:hover {
    background: var(--accent);
    color: var(--foreground);
  }
</style>
