---
import Button from '../components/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 Not Found"
  description="This page isn't here — it may have moved, or it may not be written yet."
  showHeader={false}
>
  <section class="mb-16 sm:mb-24">
    <p class="mb-4 text-sm tracking-widest uppercase">404</p>
    <h1 class="mb-6 font-serif text-3xl leading-tight font-medium sm:text-5xl sm:leading-tight">
      This page isn't written yet.
    </h1>
    <p class="mb-10 text-lg sm:text-xl">
      The link may have moved, or this may be a path that never existed. Either way, the way back is
      easy.
    </p>
    <div class="flex flex-wrap gap-4">
      <Button href="/">Back to home</Button>
      <Button href="/blog">Read the blog</Button>
    </div>
  </section>
</BaseLayout>
