---
import { getCollection } from 'astro:content';
import PostRow from '../../components/PostRow.astro';
import Site from '../../layouts/Site.astro';
import { getSiteConfig } from '../../utils/site';
import { sortByDateDesc } from '../../utils/content';
import { withBase } from '../../utils/projects';

const { site } = await getSiteConfig();
const posts = sortByDateDesc(await getCollection('blog', ({ data }) => !data.draft));
---

<Site title={`Blog | ${site.title}`} description={site.description}>
  <section class="hero-padding container head">
    <h1 class="text-3xl md:text-4xl">Blog</h1>
    <p class="muted text-lg">
      Documentation systems, AI automation, and what I learn building them.
    </p>
  </section>

  <section class="section-padding bigger-container pt-0">
    {
      posts.length > 0 ? (
        <ul class="rows">
          {posts.map((post, i) => (
            <PostRow
              href={withBase(`/blog/${post.id}/`)}
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              delay={i * 80}
            />
          ))}
        </ul>
      ) : (
        <p class="muted">No posts published yet.</p>
      )
    }
  </section>
</Site>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pt-0 {
    padding-top: 0;
  }

  .rows {
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    list-style: none;
  }
</style>
