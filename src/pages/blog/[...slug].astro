---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { sortByDateDesc } from '../../utils/content';
import { withBase } from '../../utils/projects';

export async function getStaticPaths() {
  const posts = sortByDateDesc(await getCollection('blog', ({ data }) => !data.draft));
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Article
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  heroImage={post.data.heroImage}
  showHeroImage={post.data.showHeroImage}
  tags={post.data.tags}
  backHref={withBase('/blog')}
  backLabel="All posts"
>
  <Content />
</Article>
