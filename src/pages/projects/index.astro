---
import Icon from '../../components/Icon.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Site from '../../layouts/Site.astro';
import { CATEGORY_ICONS, getProjects, getProjectsIndex, withBase } from '../../utils/projects';

const index = await getProjectsIndex();
const projects = await getProjects();

const filters = [...new Set(projects.flatMap((p) => p.data.categories))].sort((a, b) =>
  a.localeCompare(b),
);
---

<Site title={`Projects | ${index.data.title}`} description={index.data.description}>
  <section class="hero-padding container head">
    <h1 class="text-3xl md:text-4xl">{index.data.title} &amp; experiments</h1>
    <p class="muted text-lg">{index.data.description}</p>
  </section>

  <section class="section-padding bigger-container shelf pt-0">
    {
      filters.length > 1 && (
        <div class="tabs" role="group" aria-label="Filter projects by category">
          <button type="button" class="tab" data-filter="all" aria-pressed="true">
            All
          </button>
          {filters.map((f) => (
            <button type="button" class="tab" data-filter={f} aria-pressed="false">
              <Icon name={CATEGORY_ICONS[f] ?? 'folder'} size={15} />
              {f}
            </button>
          ))}
        </div>
      )
    }

    {
      projects.length > 0 ? (
        <ul class="grid">
          {projects.map((p, i) => (
            <li class="reveal" style={`--reveal-delay:${i * 90}ms`}>
              <ProjectCard
                href={withBase(`/projects/${p.id}/`)}
                title={p.data.title}
                description={p.data.description}
                heroImage={p.data.heroImage}
                categories={p.data.categories}
              />
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">Projects are being collected.</p>
      )
    }

    <p class="muted empty" hidden>Nothing filed under that category yet.</p>
  </section>
</Site>

<script>
  const shelf = document.querySelector<HTMLElement>('.shelf');

  if (shelf) {
    const tabs = [...shelf.querySelectorAll<HTMLButtonElement>('.tab')];
    const items = [...shelf.querySelectorAll<HTMLLIElement>('li')];
    const empty = shelf.querySelector<HTMLElement>('.empty');

    const apply = (active: string) => {
      let visible = 0;

      for (const item of items) {
        const link = item.querySelector<HTMLAnchorElement>('a[data-categories]');
        const cats = (link?.dataset.categories ?? '').split('|').filter(Boolean);
        const match = active === 'all' || cats.includes(active);
        item.hidden = !match;
        if (match) visible += 1;
      }

      for (const tab of tabs) {
        tab.setAttribute('aria-pressed', String(tab.dataset.filter === active));
      }

      if (empty) empty.hidden = visible > 0;
    };

    for (const tab of tabs) {
      tab.addEventListener('click', () => apply(tab.dataset.filter ?? 'all'));
    }
  }
</script>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pt-0 {
    padding-top: 0;
  }

  .tabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .tab {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    height: 2.25rem;
    padding-inline: 0.95rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--background);
    color: var(--foreground);
    font-size: 0.85rem;
    cursor: pointer;
    transition:
      background 150ms var(--ease),
      border-color 150ms var(--ease);
  }

  .tab:hover {
    background: var(--muted);
  }

  .tab[aria-pressed='true'] {
    border-color: transparent;
    background: var(--muted);
  }

  .grid {
    display: grid;
    gap: 2.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  li[hidden] {
    display: none;
  }

  .empty {
    margin-top: 2rem;
  }
</style>
