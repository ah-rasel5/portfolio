---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getProjects, withBase } from '../../utils/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Article
  title={project.data.title}
  description={project.data.description}
  date={project.data.date}
  heroImage={project.data.heroImage}
  showHeroImage={project.data.showHeroImage}
  tags={project.data.tags}
  backHref={withBase('/projects')}
  backLabel="All projects"
>
  <Content />
</Article>
