---
import PostDate from './PostDate.astro';
import Icon from './Icon.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  pinned?: boolean;
  delay?: number;
}

const { href, title, description, date, pinned = false, delay = 0 } = Astro.props;
---

<li class="row reveal" style={`--reveal-delay:${delay}ms`}>
  <a href={href}>
    <span class="body">
      <span class="head">
        {pinned && <Icon name="pin" size={18} class="pin" />}
        <span class="text-lg leading-none title">{title}</span>
      </span>

      <span class="muted text-base leading-7">{description}</span>

      <span class="text-base date"><PostDate date={date} /></span>
    </span>

    <Icon name="arrow" size={20} class="arrow" />
  </a>
</li>

<style>
  .row + .row {
    border-top: 1px solid var(--border);
  }

  a {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    justify-content: space-between;
    padding: 2.5rem;
    border-radius: inherit;
    transition: background 200ms var(--ease);
  }

  .row:first-child {
    border-top-left-radius: var(--radius-lg);
    border-top-right-radius: var(--radius-lg);
  }

  .row:last-child {
    border-bottom-right-radius: var(--radius-lg);
    border-bottom-left-radius: var(--radius-lg);
  }

  @media (hover: hover) {
    a:hover {
      background: var(--muted);
    }
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  .head {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .pin {
    flex: none;
  }

  .arrow {
    flex: none;
    margin-top: 0.125rem;
    transition: transform 300ms var(--ease);
  }

  @media (hover: hover) {
    a:hover .arrow {
      transform: translateX(4px);
    }
  }

  .date {
    line-height: 1.5rem;
  }

  @media (max-width: 640px) {
    a {
      gap: 1rem;
      padding: 1.75rem;
    }
  }
</style>
