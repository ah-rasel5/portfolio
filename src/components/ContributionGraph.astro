---
import { getCollection } from 'astro:content';

interface Props {
  weeks?: number;
}

const { weeks = 53 } = Astro.props;

// Geometry: 12px cells on a 16.5px pitch, so the grid is a fixed-ratio SVG that
// scales to whatever width the container gives it rather than overflowing.
const CELL = 12;
const PITCH = 16.5;
const ROWS = 7;
const viewWidth = weeks * PITCH - (PITCH - CELL);
const viewHeight = (ROWS - 1) * PITCH + CELL;

const posts = await getCollection('blog', ({ data }) => !data.draft);

const counts = new Map<string, number>();
for (const post of posts) {
  const key = post.data.date.toISOString().slice(0, 10);
  counts.set(key, (counts.get(key) ?? 0) + 1);
}

// Columns are weeks, rows are weekdays, ending with the current week.
const today = new Date();
const end = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate()));
end.setUTCDate(end.getUTCDate() + (6 - end.getUTCDay()));

const cells: { key: string; level: number; x: number; y: number }[] = [];
const total = weeks * ROWS;

for (let i = 0; i < total; i++) {
  const day = new Date(end);
  day.setUTCDate(day.getUTCDate() - (total - 1 - i));
  const key = day.toISOString().slice(0, 10);
  const count = counts.get(key) ?? 0;

  cells.push({
    key,
    level: count === 0 ? 0 : Math.min(count, 4),
    x: Math.floor(i / ROWS) * PITCH,
    y: (i % ROWS) * PITCH,
  });
}
---

<div class="graph">
  <svg
    class="grid"
    viewBox={`0 0 ${viewWidth} ${viewHeight}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={`Posts published over the last ${weeks} weeks`}
  >
    {
      cells.map((cell) => (
        <rect
          data-level={cell.level}
          x={cell.x}
          y={cell.y}
          width={CELL}
          height={CELL}
          rx="2.4"
          ry="2.4"
        >
          <title>{cell.key}</title>
        </rect>
      ))
    }
  </svg>
</div>

<style>
  .graph {
    display: none;
  }

  @media (min-width: 768px) {
    .graph {
      display: block;
      max-width: 100%;
      overflow: hidden;
    }
  }

  .grid {
    display: block;
    width: 100%;
    overflow: visible;
  }

  rect {
    fill: var(--muted);
  }

  rect[data-level='1'] {
    fill: var(--level-1);
  }

  rect[data-level='2'] {
    fill: var(--level-2);
  }

  rect[data-level='3'] {
    fill: var(--level-3);
  }

  rect[data-level='4'] {
    fill: var(--level-4);
  }
</style>
