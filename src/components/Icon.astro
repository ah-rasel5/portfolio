---
import {
  ArrowRight,
  BookOpen,
  BriefcaseBusiness,
  Building2,
  CalendarDays,
  Clock3,
  Compass,
  ExternalLink,
  FolderOpen,
  GalleryVerticalEnd,
  Gem,
  GitBranch,
  GitCommitHorizontal,
  Github,
  House,
  Layers3,
  Linkedin,
  Link2,
  Mail,
  MapPin,
  MessageCircle,
  Moon,
  PenLine,
  Pin,
  BookMarked,
  Sparkles,
  Star,
  Sun,
  Twitter,
  Tv,
  User,
  type Props as LucideProps,
} from 'lucide-astro';

interface Props extends Omit<LucideProps, 'name'> {
  name: string;
  size?: number | string;
  class?: string;
}

const { name, size = 20, class: className, style, ...attrs } = Astro.props;

const icons = {
  arrow: ArrowRight,
  bilibili: Tv,
  book: BookOpen,
  branch: GitBranch,
  briefcase: BriefcaseBusiness,
  home: House,
  moon: Moon,
  pin: Pin,
  sun: Sun,
  user: User,
  building: Building2,
  calendar: CalendarDays,
  clock: Clock3,
  commit: GitCommitHorizontal,
  compass: Compass,
  external: ExternalLink,
  folder: FolderOpen,
  gallery: GalleryVerticalEnd,
  github: Github,
  juejin: Gem,
  layers: Layers3,
  linkedin: Linkedin,
  link: Link2,
  mail: Mail,
  map: MapPin,
  mastodon: MessageCircle,
  pen: PenLine,
  repo: BookMarked,
  sparkle: Sparkles,
  star: Star,
  twitter: Twitter,
};

const IconComponent = icons[name as keyof typeof icons] ?? Sparkles;
const iconSize = typeof size === 'number' ? `${size}px` : size;
const iconStyle = `--icon-size: ${iconSize};${style ? ` ${style}` : ''}`;
---

<IconComponent
  {...attrs}
  size={size}
  stroke-width={attrs['stroke-width'] ?? 2}
  aria-hidden={attrs['aria-hidden'] ?? 'true'}
  focusable={attrs.focusable ?? 'false'}
  style={iconStyle}
  class:list={['site-icon', className]}
/>
