---
interface Props {
  date: Date;
  /** `short` → Jul 3, 2026 · `long` → July 3, 2026 */
  format?: 'short' | 'long';
  class?: string;
}

const { date, format = 'short', class: className } = Astro.props;

const label = new Intl.DateTimeFormat('en-US', {
  day: 'numeric',
  month: format === 'long' ? 'long' : 'short',
  year: 'numeric',
}).format(date);
---

<time class={className} datetime={date.toISOString().slice(0, 10)}>{label}</time>
